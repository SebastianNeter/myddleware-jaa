# Myddleware JAA - Environment template
# Copy to .env and set secure values (DO NOT COMMIT .env)

# Port where Myddleware will be exposed locally (see docker-compose.yml)
myddleware_port=30080

# MySQL credentials (set strong passwords)
mysql_root_password=CHANGE_ME_STRONG
mysql_password=CHANGE_ME_STRONG

# Symfony / Myddleware secret (set long random string)
app_secret=CHANGE_ME_LONG_RANDOM
